# Supabase Dashboard > Connect > App Frameworks에서 복사합니다.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# 팀 로그인용 내부 이메일 형식입니다. 실제 프로젝트 Gmail 주소로 바꾸되 Git에는 올리지 마세요.
# 예: VITE_TEAM_EMAIL_TEMPLATE=myproject+{teamCode}@gmail.com
VITE_TEAM_EMAIL_TEMPLATE=your-gmail-id+{teamCode}@gmail.com

# 화면의 팀명과 이메일 별칭에 쓴 팀 코드 연결입니다.
# 예: 빵상 팀을 myproject+bbangssang@gmail.com으로 만들었으면 아래처럼 둡니다.
VITE_TEAM_CODES={"빵상":"bbangssang"}

# 교사 로그인 화면에서 사용할 이름과 내부 인증 이메일의 연결입니다.
# 예: 로그인에 이성빈을 입력하면 wleesb09@gmail.com으로 인증합니다.
VITE_TEACHER_EMAILS={"이성빈":"teacher@example.com"}
